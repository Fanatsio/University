<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SafetySystem.Views.MainWindow"
        Title="Система безопасности и мониторинга опасной зоны" Width="1200" Height="700"
        Background="#F5F7FA">
    <Window.Styles>
        <!-- Стили для кнопок навигации -->
        <Style Selector="Button.nav">
            <Setter Property="Background" Value="#2E3A3F"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style Selector="Button.nav:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#4A5A63"/>
        </Style>
        <!-- Стили для заголовков -->
        <Style Selector="TextBlock.header">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="20"/>
        </Style>
        <Style Selector="TextBlock.subheader">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="#666"/>
            <Setter Property="Margin" Value="20,0,20,20"/>
        </Style>
        <!-- Стили для карточек -->
        <Style Selector="Border.card">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <!-- Стили для TabControl и TabItem -->
        <Style Selector="TabControl">
            <Setter Property="Background" Value="#F5F7FA"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="TabItem">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#2E3A3F"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style Selector="TabItem:selected">
            <Setter Property="Background" Value="#0078D4"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#005EA6"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="TabItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#E0E0E0"/>
        </Style>
        <Style Selector="TabItem:selected:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#005EA6"/>
        </Style>
    </Window.Styles>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="60" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top App Bar -->
        <Border Grid.ColumnSpan="2" Background="White" BorderBrush="#E6EEF6" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="220" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0">
                    <TextBlock Text="🔒" FontSize="18" VerticalAlignment="Center"/>
                    <TextBlock Text="  Система безопасности" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="Пользователь: Админ" Foreground="#666" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Button Content="⏻" Background="Transparent" BorderBrush="Transparent"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Sidebar -->
        <Border Grid.Row="1" Background="#2E3A3F" Padding="12">
            <StackPanel>
                <TextBlock Text="Система безопасности" Foreground="White" FontSize="16" FontWeight="Bold" Margin="6,6,6,10"/>
                <TextBox Watermark="Поиск..." Margin="0,0,0,10"/>
                <Separator Background="#4A5A63" Margin="0,6"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Button Content="📝  Регистрация сотрудников" Classes="nav" Click="OnRegisterWindowClick" HorizontalContentAlignment="Left"/>
                        <Button Content="👥  Список сотрудников" Classes="nav" Click="OnEmployeesButtonClick" HorizontalContentAlignment="Left"/>
                        <Button Content="📊  Мониторинг" Classes="nav" Click="OnMonitorWindowClick" HorizontalContentAlignment="Left"/>
                        <Button Content="🛤️  Контроль точек" Classes="nav" Click="OnRouteControlWindowClick" HorizontalContentAlignment="Left"/>
                        <Button Content="📈  Анализ данных" Classes="nav" Click="OnDataAnalysisWindowClick" HorizontalContentAlignment="Left"/>
                    </StackPanel>
                </ScrollViewer>
                <StackPanel VerticalAlignment="Bottom" Margin="0,10,0,0">
                    <Separator Background="#4A5A63" Margin="0,6"/>
                    <TextBlock Text="Версия 1.0" Foreground="#AAB3B8" FontSize="12" Margin="6"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Main content -->
        <TabControl Grid.Column="1" Grid.Row="1" Background="#F5F7FA">
            <TabItem Header="Главная">
                <ScrollViewer>
                    <StackPanel Margin="24">
                        <TextBlock Text="Добро пожаловать!" Classes="header" Foreground="#2E3A3F"/>
                        <TextBlock Text="Контролируйте безопасность сотрудников в реальном времени." Classes="subheader"/>
                        <WrapPanel ItemWidth="320" ItemHeight="140">
                            <Border Classes="card" Width="320" Height="140">
                                <StackPanel>
                                    <TextBlock Text="Статус системы" FontSize="18" FontWeight="SemiBold"/>
                                    <TextBlock Text="Все системы работают штатно." FontSize="14" Foreground="#666" Margin="0,6,0,8"/>
                                    <TextBlock Text="Активных тревог: 0" FontSize="14" Foreground="#28A745"/>
                                </StackPanel>
                            </Border>
                            <Border Classes="card" Width="320" Height="140">
                                <StackPanel>
                                    <TextBlock Text="Последние действия" FontSize="18" FontWeight="SemiBold"/>
                                    <TextBlock Text="Нет недавних действий." FontSize="14" Foreground="#666" Margin="0,6,0,8"/>
                                    <Button Content="Подробнее" Background="Transparent" Foreground="#0078D4" BorderBrush="#0078D4" BorderThickness="1" CornerRadius="5" Padding="8,4" HorizontalAlignment="Left"/>
                                </StackPanel>
                            </Border>
                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Уведомления">
                <StackPanel Margin="20">
                    <TextBlock Text="Активные тревоги" Classes="header" Foreground="#2E3A3F"/>
                    <ListBox Name="NotificationList" Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="5" Padding="10"/>
                </StackPanel>
            </TabItem>
        </TabControl>
    </Grid>
</Window>