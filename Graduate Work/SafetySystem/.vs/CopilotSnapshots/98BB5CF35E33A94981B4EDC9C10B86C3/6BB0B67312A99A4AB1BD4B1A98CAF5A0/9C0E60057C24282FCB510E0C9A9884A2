<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SafetySystem.Views.RegisterWindow"
        Title="Регистрация сотрудника" Width="500" Height="600"
        Background="{DynamicResource WindowBackground}">

    <Window.Resources>
        <SolidColorBrush x:Key="WindowBackground" Color="#071726"/>
        <SolidColorBrush x:Key="CardBorder" Color="#123243"/>
        <SolidColorBrush x:Key="CardForeground" Color="#E6F3FF"/>
        <SolidColorBrush x:Key="MutedText" Color="#9FB6C6"/>
        <SolidColorBrush x:Key="AccentCyan" Color="#3AD1FF"/>
    </Window.Resources>

    <Window.Styles>
        <Style Selector="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource CardForeground}"/>
        </Style>
        <Style Selector="TextBox">
            <Setter Property="Background" Value="#05242E"/>
            <Setter Property="Foreground" Value="{StaticResource CardForeground}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="8"/>
        </Style>
        <Style Selector="Button">
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="10"/>
        </Style>
    </Window.Styles>

    <StackPanel Margin="20">
        <Border Classes="card">
            <StackPanel Margin="6">
                <TextBlock Text="Регистрация сотрудника" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
                <TextBlock Text="ID сотрудника" />
                <TextBox Name="EmployeeIdTextBox" Watermark="Введите ID сотрудника" Margin="0,5,0,10"/>

                <TextBlock Text="ФИО" />
                <TextBox Name="NameTextBox" Watermark="Введите ФИО" Margin="0,5,0,10"/>

                <TextBlock Text="RFID метка" />
                <TextBox Name="RfidTagTextBox" Watermark="Введите RFID" Margin="0,5,0,10"/>

                <Button Content="Выбрать фото" Click="OnChoosePhotoClick" Margin="0,5,0,10" Background="#0B4150" Foreground="{StaticResource CardForeground}"/>
                <TextBlock Name="PhotoPathText" Text="Фотография не выбрана" Margin="0,5,0,10" Foreground="{StaticResource MutedText}"/>

                <Button Content="Сохранить сотрудника" Click="OnSaveEmployeeClick" Background="{StaticResource AccentCyan}" Foreground="#02252A" Margin="0,20,0,0"/>
            </StackPanel>
        </Border>
    </StackPanel>
</Window>
