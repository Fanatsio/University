<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SafetySystem.Views.MonitorWindow">
    <Grid RowDefinitions="Auto,*,Auto">
        <Border Grid.Row="0"
                Margin="0,0,0,12"
                Padding="16,12"
                Background="#081F2C"
                BorderBrush="{DynamicResource CardBorder}"
                BorderThickness="1"
                CornerRadius="10">
            <TextBlock Name="IntrusionAlert"
                       Text="Нет нарушений"
                       Foreground="#28A745"
                       FontWeight="SemiBold"
                       FontSize="16" />
        </Border>

        <Border Grid.Row="1"
                Classes="card"
                Margin="0"
                Padding="16"
                ClipToBounds="True"
                MinHeight="320">
            <Grid>
                <Border Background="#03131D"
                        BorderBrush="{DynamicResource CardBorder}"
                        BorderThickness="1"
                        CornerRadius="10"
                        ClipToBounds="True">
                    <Image Name="CameraStream"
                           Stretch="Uniform"
                           HorizontalAlignment="Stretch"
                           VerticalAlignment="Stretch" />
                </Border>

                <Border Name="LoadingOverlay"
                        Background="#AA041826"
                        CornerRadius="10"
                        Padding="24"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        IsVisible="True">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Мониторинг"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource CardForeground}" />
                        <TextBlock Name="LoadingStatusText"
                                   Text="Инициализация камеры..."
                                   FontSize="15"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource MutedText}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <StackPanel Grid.Row="2" Margin="0,12,0,0">
            <TextBlock Text="Люди в зоне"
                       FontSize="16"
                       Foreground="{DynamicResource CardForeground}" />
            <Border Classes="card" Margin="0,8,0,0">
                <ListBox Name="PeopleInZoneList"
                         MinHeight="140"
                         MaxHeight="200"
                         Background="Transparent"
                         Foreground="{DynamicResource CardForeground}"
                         BorderBrush="{DynamicResource CardBorder}" />
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
