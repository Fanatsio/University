<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SafetySystem.Views.MonitorWindow">
    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="14">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
            <Border Padding="16,12"
                    Background="#173329"
                    BorderBrush="#245A43"
                    BorderThickness="1"
                    CornerRadius="8">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Ellipse Width="10" Height="10" Fill="{DynamicResource AccentGreen}" VerticalAlignment="Center" />
                    <TextBlock Name="IntrusionAlert"
                               Text="Нет нарушений"
                               Foreground="{DynamicResource AccentGreen}"
                               FontWeight="SemiBold"
                               FontSize="16" />
                </StackPanel>
            </Border>

            <Border Grid.Column="1"
                    Classes="statusPill"
                    Background="#252B31"
                    BorderBrush="{DynamicResource CardBorder}"
                    BorderThickness="1"
                    VerticalAlignment="Stretch">
                <TextBlock Name="MonitorModeText"
                           Text="LIVE"
                           Foreground="{DynamicResource AccentRed}"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
            </Border>
        </Grid>

        <Border Grid.Row="1"
                Background="#0C1014"
                BorderBrush="{DynamicResource CardBorder}"
                BorderThickness="1"
                CornerRadius="8"
                ClipToBounds="True"
                MinHeight="380">
            <Grid>
                <Image Name="CameraStream"
                       Stretch="Uniform"
                       HorizontalAlignment="Stretch"
                       VerticalAlignment="Stretch" />

                <Grid RowDefinitions="*,Auto">
                    <Border Margin="14"
                            Padding="10,6"
                            CornerRadius="6"
                            Background="#B0111417"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top">
                        <TextBlock Text="Камера опасной зоны"
                                   Foreground="{DynamicResource CardForeground}"
                                   FontWeight="SemiBold" />
                    </Border>

                    <Border Grid.Row="1"
                            Margin="14"
                            Padding="12,8"
                            CornerRadius="6"
                            Background="#B0111417"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Bottom">
                        <TextBlock Text="YOLOv8 детекция персонала"
                                   Foreground="{DynamicResource MutedText}" />
                    </Border>
                </Grid>

                <Border Name="LoadingOverlay"
                        Background="#E6111417"
                        CornerRadius="8"
                        Padding="26"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        IsVisible="True">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Мониторинг"
                                   FontSize="21"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource CardForeground}" />
                        <TextBlock Name="LoadingStatusText"
                                   Text="Инициализация камеры..."
                                   FontSize="15"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource MutedText}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="2" ColumnDefinitions="1.1*,0.9*" ColumnSpacing="14">
            <Border Classes="card">
                <StackPanel Spacing="10">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <TextBlock Text="Люди в опасной зоне" Classes="sectionTitle" />
                        <TextBlock Grid.Column="1"
                                   Name="LastUpdateText"
                                   Text="Кадров пока нет"
                                   Foreground="{DynamicResource MutedText}"
                                   VerticalAlignment="Center" />
                    </Grid>
                    <ListBox Name="PeopleInZoneList"
                             MinHeight="110"
                             MaxHeight="170"
                             Background="#161B20"
                             Foreground="{DynamicResource CardForeground}"
                             BorderBrush="{DynamicResource CardBorder}" />
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Classes="card">
                <StackPanel Spacing="14">
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                        <StackPanel Spacing="3">
                            <TextBlock Text="Управление" Classes="sectionTitle" />
                            <TextBlock Name="MonitorStatusText"
                                       Text="Подготовка мониторинга"
                                       Foreground="{DynamicResource MutedText}" />
                        </StackPanel>

                        <Button Grid.Column="1"
                                Name="StartMonitorButton"
                                Classes="action"
                                Content="Старт"
                                Background="{DynamicResource AccentGreen}"
                                Foreground="#101417"
                                Click="OnStartMonitorClick" />

                        <Button Grid.Column="2"
                                Name="StopMonitorButton"
                                Classes="action"
                                Content="Пауза"
                                Background="#343C44"
                                Foreground="{DynamicResource CardForeground}"
                                Click="OnStopMonitorClick" />
                    </Grid>

                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                        <Border Background="#161B20" CornerRadius="8" Padding="12">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Всего" Foreground="{DynamicResource MutedText}" />
                                <TextBlock Name="TotalPeopleText" Text="0" Classes="metric" FontSize="28" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Background="#161B20" CornerRadius="8" Padding="12">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Опасно" Foreground="{DynamicResource MutedText}" />
                                <TextBlock Name="DangerPeopleText" Text="0" Classes="metric" FontSize="28" Foreground="{DynamicResource AccentRed}" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Background="#161B20" CornerRadius="8" Padding="12">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Безопасно" Foreground="{DynamicResource MutedText}" />
                                <TextBlock Name="SafePeopleText" Text="0" Classes="metric" FontSize="28" Foreground="{DynamicResource AccentGreen}" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <StackPanel Spacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="Прямоугольник опасной зоны" Foreground="{DynamicResource MutedText}" />
                            <TextBlock Grid.Column="1"
                                       Name="DangerZoneValueText"
                                       Text="X 25%, Y 55%, W 50%, H 35%"
                                       Foreground="{DynamicResource CardForeground}"
                                       FontWeight="SemiBold" />
                        </Grid>

                        <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="64,*" RowSpacing="6" ColumnSpacing="10">
                            <TextBlock Text="X" Foreground="{DynamicResource CardForeground}" VerticalAlignment="Center" />
                            <Slider Grid.Column="1"
                                    Name="DangerZoneXSlider"
                                    Minimum="0"
                                    Maximum="95"
                                    Value="25"
                                    TickFrequency="5"
                                    IsSnapToTickEnabled="True" />

                            <TextBlock Grid.Row="1" Text="Y" Foreground="{DynamicResource CardForeground}" VerticalAlignment="Center" />
                            <Slider Grid.Row="1"
                                    Grid.Column="1"
                                    Name="DangerZoneYSlider"
                                    Minimum="0"
                                    Maximum="95"
                                    Value="55"
                                    TickFrequency="5"
                                    IsSnapToTickEnabled="True" />

                            <TextBlock Grid.Row="2" Text="Ширина" Foreground="{DynamicResource CardForeground}" VerticalAlignment="Center" />
                            <Slider Grid.Row="2"
                                    Grid.Column="1"
                                    Name="DangerZoneWidthSlider"
                                    Minimum="5"
                                    Maximum="100"
                                    Value="50"
                                    TickFrequency="5"
                                    IsSnapToTickEnabled="True" />

                            <TextBlock Grid.Row="3" Text="Высота" Foreground="{DynamicResource CardForeground}" VerticalAlignment="Center" />
                            <Slider Grid.Row="3"
                                    Grid.Column="1"
                                    Name="DangerZoneHeightSlider"
                                    Minimum="5"
                                    Maximum="100"
                                    Value="35"
                                    TickFrequency="5"
                                    IsSnapToTickEnabled="True" />
                        </Grid>

                        <TextBlock Text="Человек считается в опасной зоне, если его рамка пересекает красный прямоугольник."
                                   Classes="subheader" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
