<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SafetySystem.Views.MainWindow"
        Title="Система безопасности и мониторинга опасной зоны"
        Width="1280"
        Height="760"
        MinWidth="1100"
        MinHeight="680"
        Background="{DynamicResource WindowBackground}">
    <Window.Resources>
        <Color x:Key="BgTop">#0B2A3A</Color>
        <Color x:Key="BgBottom">#071726</Color>
        <LinearGradientBrush x:Key="MainGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="{StaticResource BgTop}" Offset="0" />
            <GradientStop Color="{StaticResource BgBottom}" Offset="1" />
        </LinearGradientBrush>
        <SolidColorBrush x:Key="WindowBackground" Color="#071726" />
        <SolidColorBrush x:Key="CardBorder" Color="#123243" />
        <SolidColorBrush x:Key="CardForeground" Color="#E6F3FF" />
        <SolidColorBrush x:Key="MutedText" Color="#9FB6C6" />
        <SolidColorBrush x:Key="AccentCyan" Color="#3AD1FF" />
        <SolidColorBrush x:Key="AccentOrange" Color="#FFB657" />
        <SolidColorBrush x:Key="PanelBackground" Color="#041826" />
    </Window.Resources>

    <Window.Styles>
        <Style Selector="Button.nav">
            <Setter Property="Background" Value="#072533" />
            <Setter Property="Foreground" Value="{StaticResource CardForeground}" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="Margin" Value="12,6" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Button.nav:pointerover">
            <Setter Property="Background" Value="#0B4150" />
        </Style>

        <Style Selector="TextBlock.header">
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource CardForeground}" />
        </Style>
        <Style Selector="TextBlock.subheader">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{StaticResource MutedText}" />
        </Style>

        <Style Selector="Border.card">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#0D2B3A" Offset="0" />
                        <GradientStop Color="#072131" Offset="1" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="0,0,0,16" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style Selector="TextBox">
            <Setter Property="Background" Value="#05242E" />
            <Setter Property="Foreground" Value="{StaticResource CardForeground}" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="8" />
        </Style>

        <Style Selector="Button.action">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10" />
        </Style>
    </Window.Styles>

    <Grid Background="{StaticResource MainGradient}" ColumnDefinitions="260,*">
        <Border Grid.Column="0" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="0,0,1,0">
            <Grid RowDefinitions="Auto,*,Auto">
                <StackPanel Margin="18,24,18,18">
                    <TextBlock Text="Safety System" Foreground="{StaticResource CardForeground}" FontSize="20" FontWeight="Bold" />
                    <TextBlock Text="Единое рабочее окно оператора" Foreground="{StaticResource MutedText}" Margin="0,6,0,0" />
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="0,4,0,0">
                    <Button Content="Главная" Classes="nav" Click="OnHomeClick" />
                    <Button Content="Регистрация сотрудников" Classes="nav" Click="OnRegisterWindowClick" />
                    <Button Content="Список сотрудников" Classes="nav" Click="OnEmployeesButtonClick" />
                    <Button Content="Мониторинг" Classes="nav" Click="OnMonitorWindowClick" />
                    <Button Content="Контроль точек" Classes="nav" Click="OnRouteControlWindowClick" />
                    <Button Content="Анализ данных" Classes="nav" Click="OnDataAnalysisWindowClick" />
                    <Button Content="Уведомления" Classes="nav" Click="OnNotificationsClick" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1" RowDefinitions="Auto,*" Margin="24">
            <Border Classes="card" Padding="20" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock x:Name="SectionTitleText" Classes="header" Text="Главная" />
                    <TextBlock x:Name="SectionSubtitleText"
                               Classes="subheader"
                               Text="Контролируйте систему и переключайтесь между разделами без открытия новых окон." />
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Classes="card" Padding="20">
                <ContentControl x:Name="MainContentHost" />
            </Border>
        </Grid>
    </Grid>
</Window>
