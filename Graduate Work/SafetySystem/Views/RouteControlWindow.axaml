<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SafetySystem.Views.RouteControlWindow">
    <StackPanel>
        <TextBlock Text="Маршрут сотрудников"
                   Classes="header"
                   Margin="0,0,0,16" />

        <Border Classes="card" Margin="0">
            <DataGrid Name="RouteDataGrid"
                      Height="460"
                      Background="Transparent"
                      Foreground="{DynamicResource CardForeground}"
                      BorderBrush="{DynamicResource CardBorder}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Сотрудник" />
                    <DataGridTextColumn Header="Точка" />
                    <DataGridTextColumn Header="Время" />
                    <DataGridTextColumn Header="Статус" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </StackPanel>
</UserControl>
