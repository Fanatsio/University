<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SafetySystem.Views.RouteControlWindow">
    <Grid RowDefinitions="Auto,*" RowSpacing="16">
        <WrapPanel>
            <Border Classes="card" Width="430" MinWidth="300" Margin="0,0,14,14">
                <StackPanel Spacing="6">
                    <TextBlock Text="Контрольные точки" Classes="sectionTitle" />
                    <TextBlock Text="Маршруты сотрудников и отметки RFID будут отображаться в единой таблице." Classes="subheader" />
                </StackPanel>
            </Border>
            <Border Classes="card" Width="230" Margin="0,0,14,14">
                <StackPanel Spacing="6">
                    <TextBlock Text="Режим" Foreground="{DynamicResource MutedText}" />
                    <TextBlock Text="Готов" Foreground="{DynamicResource AccentGreen}" FontSize="22" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
        </WrapPanel>

        <Border Grid.Row="1" Classes="card" Padding="0">
            <DataGrid Name="RouteDataGrid"
                      Background="Transparent"
                      Foreground="{DynamicResource CardForeground}"
                      BorderBrush="{DynamicResource CardBorder}"
                      BorderThickness="0"
                      AutoGenerateColumns="False"
                      IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Сотрудник" Width="*" />
                    <DataGridTextColumn Header="Точка" Width="220" />
                    <DataGridTextColumn Header="Время" Width="180" />
                    <DataGridTextColumn Header="Статус" Width="180" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
