<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SafetySystem.Views.RegisterWindow">
    <ScrollViewer>
        <StackPanel Spacing="12">
            <Border Classes="card">
                <StackPanel Spacing="10">
                    <TextBlock Text="Регистрация сотрудника"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="{DynamicResource CardForeground}" />

                    <TextBlock Text="ID сотрудника" Foreground="{DynamicResource CardForeground}" />
                    <TextBox Name="EmployeeIdTextBox" PlaceholderText="Введите ID сотрудника" />

                    <TextBlock Text="ФИО" Foreground="{DynamicResource CardForeground}" />
                    <TextBox Name="NameTextBox" PlaceholderText="Введите ФИО" />

                    <TextBlock Text="RFID метка" Foreground="{DynamicResource CardForeground}" />
                    <TextBox Name="RfidTagTextBox" PlaceholderText="Введите RFID" />

                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button Content="Выбрать фото"
                                Classes="action"
                                Click="OnChoosePhotoClick"
                                Background="#0B4150"
                                Foreground="{DynamicResource CardForeground}" />
                        <TextBlock Name="PhotoPathText"
                                   Text="Фотография не выбрана"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource MutedText}"
                                   TextWrapping="Wrap"
                                   MaxWidth="500" />
                    </StackPanel>

                    <Button Content="Сохранить сотрудника"
                            Classes="action"
                            Click="OnSaveEmployeeClick"
                            Background="{DynamicResource AccentCyan}"
                            Foreground="#02252A"
                            HorizontalAlignment="Left" />
                </StackPanel>
            </Border>

            <Border Classes="card">
                <TextBlock Name="StatusMessageText"
                           Text="Заполните карточку сотрудника и сохраните ее."
                           Foreground="{DynamicResource MutedText}"
                           TextWrapping="Wrap" />
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
