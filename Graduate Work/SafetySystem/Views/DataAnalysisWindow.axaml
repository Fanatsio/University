<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SafetySystem.Views.DataAnalysisWindow">
    <StackPanel>
        <TextBlock Text="Анализ событий"
                   Classes="header"
                   Margin="0,0,0,16" />

        <Border Classes="card" Margin="0,0,0,16">
            <Canvas Width="740" Height="360" Background="#041826" HorizontalAlignment="Center" />
        </Border>

        <TextBlock Text="События: нарушения и штатная работа"
                   Margin="0,0,0,12"
                   Foreground="{DynamicResource MutedText}" />

        <Border Classes="card" Margin="0">
            <ListBox Name="EventList"
                     Height="220"
                     Background="Transparent"
                     Foreground="{DynamicResource CardForeground}"
                     BorderBrush="{DynamicResource CardBorder}" />
        </Border>
    </StackPanel>
</UserControl>
