<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SafetySystem.Views.DataAnalysisWindow">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="16">
        <WrapPanel>
            <Border Classes="card" Width="260" MinHeight="120" Margin="0,0,12,12">
                <StackPanel Spacing="8">
                    <TextBlock Text="События сегодня" Foreground="{DynamicResource MutedText}" />
                    <TextBlock Text="0" Classes="metric" Foreground="{DynamicResource AccentCyan}" />
                </StackPanel>
            </Border>
            <Border Classes="card" Width="260" MinHeight="120" Margin="0,0,12,12">
                <StackPanel Spacing="8">
                    <TextBlock Text="Нарушения" Foreground="{DynamicResource MutedText}" />
                    <TextBlock Text="0" Classes="metric" Foreground="{DynamicResource AccentGreen}" />
                </StackPanel>
            </Border>
            <Border Classes="card" Width="260" MinHeight="120" Margin="0,0,12,12">
                <StackPanel Spacing="8">
                    <TextBlock Text="Среднее время реакции" Foreground="{DynamicResource MutedText}" />
                    <TextBlock Text="--" Classes="metric" Foreground="{DynamicResource AccentAmber}" />
                </StackPanel>
            </Border>
        </WrapPanel>

        <Border Classes="card">
            <Grid RowDefinitions="Auto,*" RowSpacing="16">
                <TextBlock Text="Динамика событий" Classes="sectionTitle" />
                <Grid Grid.Row="1" MinHeight="260" MaxHeight="360">
                    <Border Background="#161B20" CornerRadius="8" />
                    <Canvas Margin="24">
                        <Rectangle Canvas.Left="28" Canvas.Top="218" Width="54" Height="58" Fill="{DynamicResource AccentGreen}" RadiusX="4" RadiusY="4" />
                        <Rectangle Canvas.Left="112" Canvas.Top="190" Width="54" Height="86" Fill="{DynamicResource AccentCyan}" RadiusX="4" RadiusY="4" />
                        <Rectangle Canvas.Left="196" Canvas.Top="236" Width="54" Height="40" Fill="{DynamicResource AccentGreen}" RadiusX="4" RadiusY="4" />
                        <Rectangle Canvas.Left="280" Canvas.Top="168" Width="54" Height="108" Fill="{DynamicResource AccentAmber}" RadiusX="4" RadiusY="4" />
                        <Rectangle Canvas.Left="364" Canvas.Top="228" Width="54" Height="48" Fill="{DynamicResource AccentGreen}" RadiusX="4" RadiusY="4" />
                        <Rectangle Canvas.Left="448" Canvas.Top="206" Width="54" Height="70" Fill="{DynamicResource AccentCyan}" RadiusX="4" RadiusY="4" />
                        <Line StartPoint="24,276" EndPoint="540,276" Stroke="#3A444D" StrokeThickness="1" />
                    </Canvas>
                </Grid>
            </Grid>
        </Border>

        <Border Classes="card">
            <StackPanel Spacing="10">
                <TextBlock Text="Журнал событий" Classes="sectionTitle" />
                <ListBox Name="EventList"
                         Height="170"
                         Background="#161B20"
                         Foreground="{DynamicResource CardForeground}"
                         BorderBrush="{DynamicResource CardBorder}">
                    <ListBoxItem Content="Событий для отображения пока нет." />
                </ListBox>
            </StackPanel>
        </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
