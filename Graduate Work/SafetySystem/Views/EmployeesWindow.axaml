<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="clr-namespace:SafetySystem.ViewModels"
             x:Class="SafetySystem.Views.EmployeesWindow"
             x:DataType="viewModels:EmployeesViewModel">
    <Grid RowDefinitions="*,Auto">
        <DataGrid x:Name="EmployeesDataGrid"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  CanUserResizeColumns="True"
                  CanUserSortColumns="True"
                  ItemsSource="{Binding Employees}"
                  Margin="0,0,0,12"
                  Background="Transparent"
                  Foreground="{DynamicResource CardForeground}"
                  BorderBrush="{DynamicResource CardBorder}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID сотрудника" Binding="{Binding EmployeeId}" Width="180" />
                <DataGridTextColumn Header="ФИО" Binding="{Binding Name}" Width="*" />
                <DataGridTextColumn Header="RFID" Binding="{Binding RfidTag}" Width="220" />
                <DataGridTextColumn Header="Фото" Binding="{Binding PhotoPath}" Width="260" />
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.RowSpan="2"
                   Text="Нет данных для отображения"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   IsVisible="{Binding NoDataMessageVisible}"
                   FontSize="16"
                   Foreground="{DynamicResource MutedText}" />

        <TextBlock Grid.Row="1"
                   Text="Список обновляется при каждом открытии раздела."
                   Foreground="{DynamicResource MutedText}" />
    </Grid>
</UserControl>
