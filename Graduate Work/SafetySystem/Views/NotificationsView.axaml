<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SafetySystem.Views.NotificationsView">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="16">
        <WrapPanel>
            <Border Classes="card" Width="260" MinHeight="120" Margin="0,0,12,12">
                <StackPanel Spacing="8">
                    <TextBlock Text="Активные" Foreground="{DynamicResource MutedText}" />
                    <TextBlock Text="0" Classes="metric" Foreground="{DynamicResource AccentGreen}" />
                </StackPanel>
            </Border>
            <Border Classes="card" Width="260" MinHeight="120" Margin="0,0,12,12">
                <StackPanel Spacing="8">
                    <TextBlock Text="Ожидают реакции" Foreground="{DynamicResource MutedText}" />
                    <TextBlock Text="0" Classes="metric" Foreground="{DynamicResource AccentCyan}" />
                </StackPanel>
            </Border>
            <Border Classes="card" Width="260" MinHeight="120" Margin="0,0,12,12">
                <StackPanel Spacing="8">
                    <TextBlock Text="Критические" Foreground="{DynamicResource MutedText}" />
                    <TextBlock Text="0" Classes="metric" Foreground="{DynamicResource AccentAmber}" />
                </StackPanel>
            </Border>
        </WrapPanel>

        <WrapPanel>
            <Border Classes="card" Width="430" MinWidth="300" Margin="0,0,16,16">
                <StackPanel Spacing="12">
                    <TextBlock Text="Лента уведомлений" Classes="sectionTitle" />
                    <ListBox Name="NotificationList"
                             Height="360"
                             Background="#161B20"
                             BorderBrush="{DynamicResource CardBorder}"
                             Foreground="{DynamicResource CardForeground}">
                        <ListBoxItem Content="Тревог нет. Система работает штатно." />
                    </ListBox>
                </StackPanel>
            </Border>

            <Border Classes="card" Width="360" MinWidth="280" Margin="0,0,16,16">
                <StackPanel Spacing="14">
                    <TextBlock Text="Каналы контроля" Classes="sectionTitle" />
                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="12" ColumnSpacing="12">
                        <Border Width="10" Height="10" CornerRadius="5" Background="{DynamicResource AccentGreen}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="Нарушения опасной зоны" Classes="subheader" />

                        <Border Grid.Row="1" Width="10" Height="10" CornerRadius="5" Background="{DynamicResource AccentCyan}" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="Служебные сообщения" Classes="subheader" />

                        <Border Grid.Row="2" Width="10" Height="10" CornerRadius="5" Background="{DynamicResource AccentAmber}" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="События RFID-точек" Classes="subheader" />
                    </Grid>
                </StackPanel>
            </Border>
        </WrapPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
